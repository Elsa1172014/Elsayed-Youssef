# Created automatically by ./scripts/setup.sh with random secrets. Copy by hand only if you prefer.

# Postgres password for the bundled database (any long random string)
POSTGRES_PASSWORD=

# Encrypts stored source credentials: 32 random bytes, base64.   openssl rand -base64 32
# BACK THIS UP: losing it makes saved Xtream credentials unreadable.
SECRET_KEY=

# ":80" = plain HTTP on port 80. A domain name (e.g. tv.example.com) = automatic HTTPS.
SITE_ADDRESS=:80

# Optional: use an external/managed Postgres instead of the bundled one, then start with:
#   docker compose up -d --build --no-deps api worker web
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Optional: catalog source mirror (default is the official iptv-org API)
# IPTV_ORG_API=https://iptv-org.github.io/api
