# Required in production
DATABASE_URL=postgres://user:pass@host:5432/receiver
# 32 random bytes, base64: openssl rand -base64 32  (use a KMS-managed key in production)
SECRET_KEY=
PORT=3000
# Development uses an in-memory PGlite database when DATABASE_URL is unset (refused in production).

# Comma-separated browser origins allowed cross-origin (web app host, packaged TV app origins)
ALLOWED_ORIGINS=
# Set true only when running behind a trusted reverse proxy so rate limits see real client IPs
TRUST_PROXY=false
