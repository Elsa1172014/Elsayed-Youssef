# ── Public (safe for the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only. NEVER prefix with NEXT_PUBLIC_. Set in Vercel / worker host env, not in git. ──
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Models (defaults shown are configuration, verify availability on your account)
TUTOR_MODEL=gpt-5-mini
VISION_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ── Limits & budgets (units: requests per window / USD-equivalent tokens per day) ──
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_VISION_PER_MIN=6
RATE_LIMIT_REALTIME_TOKEN_PER_HOUR=10
BUDGET_TUTOR_TOKENS_PER_USER_DAY=200000
BUDGET_VISION_CALLS_PER_USER_DAY=200
BUDGET_REALTIME_SECONDS_PER_USER_DAY=3600
BUDGET_GLOBAL_TUTOR_TOKENS_PER_DAY=5000000

# ── Worker (separate process) ──
INGEST_WORKER_ID=
INGEST_LEASE_SECONDS=120
INGEST_POLL_MS=3000
INGEST_OCR=0            # 1 = OCR pages with no text layer via the vision adapter (costs money)
PAGE_IMAGE_DPI=110
